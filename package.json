{
  "name": "gym-lc-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node tools/scripts/dev.mjs",
    "build": "node tools/scripts/build.mjs",
    "start": "node backend/src/server.ts",
    "dev:backend": "node backend/src/server.ts",
    "dev:frontend": "vite frontend --config frontend/vite.config.ts",
    "db:setup": "node tools/scripts/db.mjs",
    "db:demo": "node tools/scripts/db.mjs --demo",
    "db:test": "node tools/scripts/db.mjs --test --demo",
    "test": "node --test tools/tests/gym.test.mjs tools/tests/validation.test.mjs",
    "test:mysql": "node tools/tests/mysql.test.mjs",
    "test:system": "node tools/tests/system.test.mjs",
    "test:e2e": "playwright test --config tools/tests/playwright.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p backend/tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p frontend/tsconfig.json",
    "lint": "oxlint -c tools/scripts/config/.oxlintrc.json backend/src frontend/src",
    "format": "oxfmt --config tools/scripts/config/.oxfmtrc.json backend frontend scripts tests",
    "test:all": "node tools/scripts/run-tests.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "1.31.0",
    "mysql2": "^3.24.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
